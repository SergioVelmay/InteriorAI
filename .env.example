# =============================================================================
# InteriorAI — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` a git.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Proveedor de IA: `mock` (sin credenciales, sin coste) o `azure`
AI_PROVIDER_MODE=mock

# --- Azure AI Foundry ---------------------------------------------------------
# Solo el host del recurso, SIN ruta: https://<tu-recurso>.services.ai.azure.com
# (las rutas /openai/v1/... y /providers/... las añade el código)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# Opcional: la API v1 (/openai/v1/) no usa api-version. Dejar vacío salvo necesidad.
AZURE_FOUNDRY_API_VERSION=
# Opcional: host del renderizador si está en otro recurso (vacío = usa AZURE_FOUNDRY_ENDPOINT)
AZURE_FOUNDRY_RENDERER_ENDPOINT=
# Ruta del renderizador fotorrealista (API del proveedor, distinta de /openai/v1)
AZURE_FOUNDRY_RENDERER_PATH=/providers/blackforestlabs/v1/flux-2-pro
# api-version de la API del renderizador (la del proveedor sí la exige)
AZURE_FOUNDRY_RENDERER_API_VERSION=preview
AZURE_FOUNDRY_TIMEOUT_S=120
AZURE_FOUNDRY_MAX_RETRIES=3

# --- Despliegues por ROL funcional --------------------------------------------
# El código solo conoce los roles; aquí se asocia cada rol a su despliegue. Nombres desde la
# 3.0.0: los anteriores (PROMPT_ENGINEER, FAST_DRAFT, STRUCTURAL_COMPOSER,
# PHOTOREALISTIC_RENDERER, GEOMETRIC_AUDITOR) ya no se leen; la app avisa si los encuentra.
# Texto: prompts de imagen (luna, en cada generación), fichas de referencias (sol, visión precisa)
# y auditoría (astra, razonamiento fuerte). Imagen: bocetos, retoques con máscara y fotorrealismo.
DEPLOYMENT_ROLE_PROMPT_ARCHITECT=gpt-6-luna
DEPLOYMENT_ROLE_GEOMETRY_AUDITOR=gpt-6-astra
DEPLOYMENT_ROLE_REFERENCE_ANALYST=gpt-6.1-sol
DEPLOYMENT_ROLE_FAST_DRAFT_MAKER=gpt-image-2.5-flare
DEPLOYMENT_ROLE_COMPOSITION_BUILDER=gpt-image-2.5-sunburst
DEPLOYMENT_ROLE_REALISTIC_RENDERER=FLUX.2-pro

# --- Razonamiento de los roles de texto -------------------------------------------
# Esfuerzo por rol (low | medium | high; el auditor admite también max). El razonamiento se
# factura como salida y alarga la respuesta.
PROMPT_ARCHITECT_REASONING_EFFORT=medium
REFERENCE_ANALYST_REASONING_EFFORT=medium
# Auditor Geométrico: esfuerzo y timeout propio. Las auditorías con razonamiento tardan
# minutos: los timeouts NUNCA se reintentan.
GEOMETRY_AUDITOR_REASONING_EFFORT=medium
GEOMETRY_AUDITOR_TIMEOUT_S=900

# --- Almacenamiento y costes --------------------------------------------------
DATA_DIR=/app/data
PRICING_FILE=/app/config/pricing.yaml
MAX_UPLOAD_MB=25

# --- Red interna (docker-compose) ---------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://backend:8000
FRONTEND_PORT=7860

# --- Avisos de gasto de IA (solo avisan, nunca bloquean) --------------------------------
# Gasto real (sin simulación) a partir del cual la interfaz avisa: por proyecto y en total.
COST_ALERT_PROJECT_EUR=3
COST_ALERT_TOTAL_EUR=10

# --- Contenedores ------------------------------------------------------------------------
# Usuario con el que se ejecutan backend y frontend (y propietario de ./data). En Linux, usa
# el tuyo si no es el 1000 (`id -u` / `id -g`); en Docker Desktop no hace falta cambiarlo.
APP_UID=1000
APP_GID=1000
