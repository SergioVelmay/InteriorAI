# =============================================================================
# InteriorAI — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` a git.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Proveedor de IA: `mock` (sin credenciales, sin coste) o `azure`
AI_PROVIDER_MODE=mock

# --- Azure AI Foundry ---------------------------------------------------------
# Solo el host del recurso, SIN ruta: https://<tu-recurso>.services.ai.azure.com
# (las rutas /openai/v1/... y /providers/... las añade el código)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
# Opcional: la API v1 (/openai/v1/) no usa api-version. Dejar vacío salvo necesidad.
AZURE_FOUNDRY_API_VERSION=
# Opcional: host del renderizador si está en otro recurso (vacío = usa AZURE_FOUNDRY_ENDPOINT)
AZURE_FOUNDRY_RENDERER_ENDPOINT=
# Ruta del renderizador fotorrealista (API del proveedor, distinta de /openai/v1)
AZURE_FOUNDRY_RENDERER_PATH=/providers/blackforestlabs/v1/flux-2-pro
# api-version de la API del renderizador (la del proveedor sí la exige)
AZURE_FOUNDRY_RENDERER_API_VERSION=preview
AZURE_FOUNDRY_TIMEOUT_S=120
AZURE_FOUNDRY_MAX_RETRIES=3

# --- Despliegues por ROL funcional --------------------------------------------
# El código solo conoce los roles; aquí se asocia cada rol a su despliegue.
DEPLOYMENT_ROLE_PROMPT_ENGINEER=gpt-6.1-sol
DEPLOYMENT_ROLE_GEOMETRIC_AUDITOR=gpt-6-astra
DEPLOYMENT_ROLE_CONTEXT_MANAGER=gpt-6-luna
DEPLOYMENT_ROLE_FAST_DRAFT=gpt-image-2.5-flare
DEPLOYMENT_ROLE_STRUCTURAL_COMPOSER=gpt-image-2.5-sunburst
DEPLOYMENT_ROLE_PHOTOREALISTIC_RENDERER=FLUX.2-pro

# Auditor Geométrico: esfuerzo de razonamiento (low | medium | high | max) y timeout propio.
# Las auditorías con razonamiento tardan minutos: los timeouts NUNCA se reintentan.
GEOMETRIC_AUDITOR_REASONING_EFFORT=medium
GEOMETRIC_AUDITOR_TIMEOUT_S=900

# --- Almacenamiento y costes --------------------------------------------------
DATA_DIR=/app/data
PRICING_FILE=/app/config/pricing.yaml
MAX_UPLOAD_MB=25

# --- Red interna (docker-compose) ---------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://backend:8000
FRONTEND_PORT=7860
