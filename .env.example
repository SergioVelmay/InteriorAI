# =============================================================================
# InteriorAI — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` a git.
# =============================================================================

# --- Aplicación ---------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Proveedor de IA: `mock` (sin credenciales, sin coste) o `azure`
AI_PROVIDER_MODE=mock

# --- Azure AI Foundry ---------------------------------------------------------
# Endpoint del recurso, p. ej. https://<tu-recurso>.services.ai.azure.com
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_API_VERSION=
# Endpoint específico para el renderizador (FLUX) si difiere del principal (opcional)
AZURE_FOUNDRY_RENDERER_ENDPOINT=
AZURE_REQUEST_TIMEOUT_S=120
AZURE_MAX_RETRIES=3

# --- Despliegues por ROL funcional --------------------------------------------
# El código solo conoce los roles; aquí se asocia cada rol a su despliegue.
DEPLOYMENT_ROLE_PROMPT_ENGINEER=gpt-6.1-sol
DEPLOYMENT_ROLE_GEOMETRIC_AUDITOR=gpt-6-astra
DEPLOYMENT_ROLE_CONTEXT_MANAGER=gpt-6-luna
DEPLOYMENT_ROLE_FAST_DRAFT=gpt-image-2.5-flare
DEPLOYMENT_ROLE_STRUCTURAL_COMPOSER=gpt-image-2.5-sunburst
DEPLOYMENT_ROLE_PHOTOREALISTIC_RENDERER=FLUX.2-pro

# Esfuerzo de razonamiento del Auditor Geométrico (pendiente verificar `max`: BACKLOG B-001)
GEOMETRIC_AUDITOR_REASONING_EFFORT=max

# --- Almacenamiento y costes --------------------------------------------------
DATA_DIR=/app/data
PRICING_FILE=/app/config/pricing.yaml
MAX_UPLOAD_MB=25

# --- Red interna (docker-compose) ---------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://backend:8000
FRONTEND_PORT=7860
