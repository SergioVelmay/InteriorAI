                  "pm.test(\"todas las imágenes subidas son referencias\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.lengthOf(2);",
                  "  pm.expect(b.map(a => a.kind)).to.eql([\"referencia\", \"referencia\"]);",
                  "  pm.expect(b.map(a => a.id)).to.include(pm.collectionVariables.get(\"planoId\"));",
                  "});"
