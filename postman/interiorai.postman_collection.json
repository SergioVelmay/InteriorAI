          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assets/plano",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/plano.png"
