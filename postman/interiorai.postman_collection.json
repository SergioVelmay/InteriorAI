            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"plano.png\",\n  \"data_base64\": \"iVBORw0KGgoAAAANSUhEUgAAACAAAAAYCAIAAAAUMWhjAAAAJ0lEQVR42mPsjvnGQEvAxEBjMGrBqAWjFoxaMGrBqAWjFoxaQB0AANHqAg034bUdAAAAAElFTkSuQmCC\"\n}",
              "options": {
