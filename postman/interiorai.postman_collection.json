    {
      "name": "04 Pipelines (solo mock)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Seguro de costes: fuera de AI_PROVIDER_MODE=mock estas peticiones no se envían.",
              "if (pm.collectionVariables.get(\"aiMode\") !== \"mock\") {",
              "  console.warn(\"Backend fuera de mock: se omiten los pipelines (tendrían coste)\");",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Subir referencia con notas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"pipelineRefId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assets/referencia/base64",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"sofa.png\",\n  \"data_base64\": \"iVBORw0KGgoAAAANSUhEUgAAACAAAAAYCAIAAAAUMWhjAAAAJ0lEQVR42mPsjvnGQEvAxEBjMGrBqAWjFoxaMGrBqAWjFoxaQB0AANHqAg034bUdAAAAAElFTkSuQmCC\",\n  \"description\": \"Sofá 285 x 160 x 87 cm\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Analizar la referencia con sus notas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"receta y ficha guardada desde el análisis (B-029)\", () => {",
                  "  const a = pm.response.json().asset;",
                  "  pm.expect(a.description).to.eql(\"Sofá 285 x 160 x 87 cm\");",
                  "  pm.expect(a.sheet.recipe).to.have.property(\"objetos\");",
                  "  pm.expect(a.sheet.recipe).to.have.property(\"otros\");",
                  "  pm.expect(a.sheet.prompt_version).to.match(/^reference_analyst@/);",
                  "  pm.expect(a.sheet.selected.length).to.be.above(0); // el mock marca todo",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assets/{{pipelineRefId}}/analyze",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Analizar las referencias pendientes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"solo las que no tienen receta: la imagen del espacio (B-028)\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.indexed).to.have.lengthOf(1);",
                  "  pm.expect(b.skipped).to.eql([pm.collectionVariables.get(\"pipelineRefId\")]);",
                  "  pm.expect(b.indexed[0].sheet).to.not.be.null;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/references/index",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Guardar ficha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"lo marcado, en el orden de la receta (B-030)\", () => {",
                  "  pm.expect(pm.response.json().sheet.selected).to.eql([\"objetos:0\", \"colores:0\"]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assets/{{pipelineRefId}}/sheet",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"selected\": [\"colores:0\", \"objetos:0\"]\n}",
