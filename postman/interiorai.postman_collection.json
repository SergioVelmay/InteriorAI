                  "    .to.eql(pm.collectionVariables.get(\"planoId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assets/plano",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
