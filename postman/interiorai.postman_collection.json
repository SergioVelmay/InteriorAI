                  "pm.collectionVariables.set(\"referenciaId\", pm.response.json().id);",
                  "pm.test(\"dimensiones\", () => pm.expect(pm.response.json().width_px).to.eql(32));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assets/referencia/base64",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"referencia_ikea.png\",\n  \"data_base64\": \"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAAYCAIAAAAUMWhjAAAAJ0lEQVR42mPsjvnGQEvAxEBjMGrBqAWjFoxaMGrBqAWjFoxaQB0AANHqAg034bUdAAAAAElFTkSuQmCC\"\n}",
