    {
      "name": "04 Pipelines (solo mock)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Seguro de costes: fuera de AI_PROVIDER_MODE=mock estas peticiones no se envían.",
              "if (pm.collectionVariables.get(\"aiMode\") !== \"mock\") {",
              "  console.warn(\"Backend fuera de mock: se omiten los pipelines (tendrían coste)\");",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Subir referencia para indexar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
