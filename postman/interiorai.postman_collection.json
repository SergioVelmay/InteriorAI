{
  "info": {
    "name": "InteriorAI API",
    "description": "Flujo completo de la API v1 de InteriorAI (proyectos y assets).\n\npostman collection run postman/interiorai.postman_collection.json -e postman/local.postman_environment.json --working-dir postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Sistema",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status ok y modo mock\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.status).to.eql(\"ok\");",
                  "  pm.expect(b.mode).to.eql(\"mock\");",
                  "});",
                  "pm.collectionVariables.set(\"aiMode\", pm.response.json().mode);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Tipos de asset",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"solo se suben referencias; render no se puede subir\", () => {",
                  "  const kinds = pm.response.json();",
                  "  pm.expect(kinds.map(k => k.value)).to.eql([\"referencia\", \"render\"]);",
                  "  pm.expect(kinds.find(k => k.value === \"render\").uploadable).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/asset-kinds"
          }
        }
      ]
    },
    {
      "name": "02 Proyectos",
      "item": [
        {
          "name": "Crear proyecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"projectId\", b.id);",
                  "pm.test(\"Location apunta al proyecto\", () => {",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.include(b.id);",
                  "});",
                  "pm.test(\"estructura inicial\", () => {",
                  "  pm.expect(b).to.not.have.property(\"space_type\");",
                  "  pm.expect(b.assets).to.eql([]);",
                  "  pm.expect(b.schema_version).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salón principal (Postman)\",\n  \"description\": \"Proyecto creado por la colección de Postman.\\n\\nEstilo nórdico, tonos cálidos, mucha luz natural. 4,2 x 7,5 m.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear proyecto inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"space_type\": \"salon\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar proyectos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"incluye el proyecto creado\", () => {",
                  "  const ids = pm.response.json().map(p => p.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get(\"projectId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects"
          }
        },
        {
          "name": "Ver proyecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"descripción guardada\", () => {",
                  "  pm.expect(pm.response.json().description).to.include(\"7,5 m\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}"
          }
        },
        {
          "name": "Editar proyecto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"nombre actualizado y descripción intacta\", () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.name).to.eql(\"Salón principal (editado)\");",
                  "  pm.expect(b.description).to.include(\"nórdico\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Salón principal (editado)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "03 Assets",
      "item": [
        {
          "name": "Subir imagen del espacio (multipart)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"planoId\", b.id);",
                  "pm.test(\"tipo y dimensiones detectados\", () => {",
                  "  pm.expect(b.mime_type).to.eql(\"image/png\");",
                  "  pm.expect(b.width_px).to.eql(160);",
                  "  pm.expect(b.height_px).to.eql(120);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assets/referencia",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/plano.png"
                }
              ]
            }
          }
        },
        {
          "name": "Subir imagen duplicada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"indica el asset existente\", () => {",
                  "  pm.expect(pm.response.json().existing_asset_id)",
                  "    .to.eql(pm.collectionVariables.get(\"planoId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assets/referencia",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "fixtures/plano.png"
                }
              ]
            }
          }
        },
        {
          "name": "Subir referencia (Base64)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
