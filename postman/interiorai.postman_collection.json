            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/assets/referencia/base64",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"filename\": \"sofa.png\",\n  \"data_base64\": \"iVBORw0KGgoAAAANSUhEUgAAACAAAAAYCAIAAAAUMWhjAAAAJ0lEQVR42mPsjvnGQEvAxEBjMGrBqAWjFoxaMGrBqAWjFoxaQB0AANHqAg034bUdAAAAAElFTkSuQmCC\",\n  \"description\": \"Sofá 285 x 160 x 87 cm\"\n}",
